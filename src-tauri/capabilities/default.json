{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "HGhub 默认能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-exit",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-always-on-top",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-fullscreen",
    "allow-hpp-manage",
    "allow-pick-plugin-files",
    "allow-pick-plugin-directory",
    "allow-app-boot",
    "allow-security-set",
    "allow-set-orientation",
    "allow-set-status-bar-hidden",
    "allow-adjust-brightness",
    "allow-adjust-volume",
    "allow-share-file",
    "allow-open-senplayer",
    "allow-export-to-photos",
    "allow-download-media",
    "allow-list-downloads",
    "allow-delete-download",
    "allow-serve-download",
    "allow-debug-log",
    "allow-open-url",
    "allow-open-external-media",
    "allow-open-webhome",
    "allow-webhome-player-state",
    "allow-native-player-open",
    "allow-native-player-close",
    "allow-native-player-play",
    "allow-native-player-pause",
    "allow-native-player-seek",
    "allow-native-player-set-rate",
    "allow-native-player-set-volume",
    "allow-native-player-state"
  ]
}